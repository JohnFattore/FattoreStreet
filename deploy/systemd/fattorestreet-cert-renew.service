# Installed by deploy/deploy.sh, which replaces @DEPLOY_DIR@ with the host
# clone's deploy/ directory. Started by fattorestreet-cert-renew.timer.
[Unit]
Description=Renew the fattorestreet.com TLS certificate and reload nginx
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A oneshot has no start timeout by default, and the timer never starts a unit
# that is still running: one hung certbot/docker call would silently skip every
# later renewal. A normal run takes well under a minute.
TimeoutStartSec=30min
ExecStart=@DEPLOY_DIR@/renew-cert.sh
