# Installed and enabled by deploy/deploy.sh.
[Unit]
Description=Twice-daily TLS certificate renewal check

[Timer]
# Twice a day at a random offset, per Let's Encrypt's guidance; Persistent
# runs a check missed while the host was down at the next boot.
OnCalendar=*-*-* 00,12:00:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
