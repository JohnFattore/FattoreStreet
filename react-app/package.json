    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.9",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
