{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.tsx",
  "scripts": {
    "dev": "vite",
    "staging": "vite --mode staging",
    "build": "tsc && vite build --emptyOutDir",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
