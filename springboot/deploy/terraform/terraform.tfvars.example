# Copy to terraform.tfvars and fill in your account-specific values.

aws_region = "us-east-1"

# Same VPC as the EC2 instance running Postgres.
vpc_id                = "vpc-0123456789abcdef0"
public_subnet_ids     = ["subnet-0aaa...", "subnet-0bbb..."]
ec2_security_group_id = "sg-0123456789abcdef0" # SG on the EC2 Postgres instance

# Postgres on the EC2 box.
db_host     = "10.0.1.23" # instance private IP, or its private DNS name
db_name     = "springboot"
db_username = "postgres"

# Secrets Manager ARN of the single app-config secret (fattorestreet/env, a JSON
# object). The task reads POSTGRES_PASSWORD and SECRET_KEY out of it by key.
env_secret_arn = "arn:aws:secretsmanager:us-east-1:111122223333:secret:fattorestreet/env-AbCdEf" # pragma: allowlist secret

# Image + sizing.
image_tag      = "latest"
task_memory    = 4096 # drop toward 2048 after profiling a real run
hist_load_days = 20

# Schedule: 02:00 America/New_York daily.
schedule_expression = "cron(0 2 * * ? *)"
schedule_timezone   = "America/New_York"
schedule_enabled    = true

# Index load: 05:00 America/New_York daily (3h after the hist load so fresh
# DailyPrice rows exist, still pre-market). Shares schedule_timezone above.
index_load_schedule_expression = "cron(0 5 * * ? *)"
index_load_schedule_enabled    = true
index_load_task_memory         = 2048 # SEC-rate-limit bound; tune after profiling a real run

# Fundamentals load (SEC XBRL frames sync): 13:30 America/New_York daily, clear
# of the other two loads — the SEC rate limiter is per-process, so overlapping
# tasks double the effective request rate and earn 403s for both.
fundamentals_load_schedule_expression = "cron(30 13 * * ? *)"
fundamentals_load_schedule_enabled    = true
fundamentals_load_years_back          = 1 # current + prior year; raising this multiplies SEC requests

# Email alerted when a nightly task exits non-zero or fails to start (confirm
# the SNS subscription once after apply). Leave "" to disable alerting.
notification_email = "you@example.com"
